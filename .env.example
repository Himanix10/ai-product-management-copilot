# Google OAuth 2.0 Credentials (Template - Replace with your actual credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8501

# OpenRouter keys are tried in order when a key is rate-limited or unavailable.
OPENROUTER_API_KEY_1=your-openrouter-key-1
OPENROUTER_API_KEY_2=your-openrouter-key-2
OPENROUTER_API_KEY_3=your-openrouter-key-3
OPENROUTER_API_KEY_4=your-openrouter-key-4
OPENROUTER_MODEL=google/gemma-4-31b-it:free
